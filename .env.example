# choi-media 웹(.env)의 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY와 같은 값을 넣는다.
# Expo는 클라이언트에 노출할 환경변수에 EXPO_PUBLIC_ 접두사가 필요하다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 알림 감지 → 웹 서버 인제스트 엔드포인트.
EXPO_PUBLIC_INGEST_ENDPOINT=https://snailbook.cloud/api/notifications/ingest

# ── EXPO_PUBLIC_INGEST_SECRET (choi-media의 NOTIFY_INGEST_SECRET과 같은 값) ──
# 이 파일이나 .env에 넣지 말 것. 둘 다 git에 커밋된다.
#   로컬 개발 → .env.local 에 작성 (git 무시됨)
#   EAS Build → eas env:set --name EXPO_PUBLIC_INGEST_SECRET --value '<값>' \
#                 --environment production --visibility sensitive
#   기존 값 받아오기 → eas env:pull --environment development
